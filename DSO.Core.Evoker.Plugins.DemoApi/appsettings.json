{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Evoker": {
    // İsimle erişime açılan assembly/namespace/tip kalıpları (api/evoker/types/...). Varsayılan BOŞ = kapalı.
    // Örnek: [ "System.Math", "DSO.Core.Evoker.Plugins.DemoApi.Services.*" ]
    "AllowTypesFrom": [ "DSO.Core.Evoker.Plugins.DemoApi.Services.Sayac" ],
    "Plugins": {
      // Göreli yollar UYGULAMA KLASÖRÜNE (bin/Debug/net6.0 ya da yayın klasörü) göredir.
      // Kayıtlarda DLL yolları Plugins klasörüne GÖRELİ saklanır.
      "PluginsRoot": "Plugins",
      "RegistrationsFile": "App_Data/plugins.json",
      // Boş: önce uygulama klasörünün Host alt klasöründe DSO.Core.Evoker.PluginHost aranır.
      "WorkerPath": "",
      "WarmStart": true,
      "StartupTimeoutMs": 15000,
      "CrashLogFile": "App_Data/crash.log",
      "ListIncludesSummary": true
    }
  }
}
 
